# Example environment file - Copy this to config/env/development.env and fill in your values

# Server Configuration
SERVER_PORT=

# Database config
DATABASE_HOST=localhost
DATABASE_PORT=5432 # Default PostgreSQL port, change if using a different database
DATABASE_USER=postgres
DATABASE_PASS=postgres
DATABASE_NAME=demo_tenant
DATABASE_SYNC=false
DATABASE_LOG=true
DATABASE_CACHE=true
DATABASE_SSL=false

# Logger service
LOG_ENABLE=

# JWT config
JWT_EXPIRE_IN=
JWT_SECRET_KEY=
REFRESH_TOKEN_EXPIRE_IN=
REFRESH_TOKEN_SECRET_KEY=

FORGOT_PASSWORD_EMAIL_VALID_TILL=

# Mailer service config
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=
EMAIL_PORT=
EMAIL_SECURE=

# AWS S3 config
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PRIVATE_BUCKET_NAME=


OTP_EXPIRE_TIME=
OTP_ENABLED=

DOC_URL=

FRONTEND_BASE_URL=
ADMIN_BASE_URL=

STRIPE_SECRET_KEY=
FCM_SERVER_KEY=

#Cookie Parser Secret Key
COOKIE_SECRET=

#Allowed Origins
WHITELIST=[]

# Sentry Configuration Reference : https://docs.nestjs.com/recipes/sentry
# Sentry DSN (Data Source Name) - Get this from your Sentry project settings
SENTRY_DSN=

# Environment (optional, defaults to NODE_ENV)
SENTRY_ENVIRONMENT=

# Sampling rates for performance monitoring
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=

# Enable/disable Sentry
SENTRY_ENABLED=
